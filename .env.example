# LinkedIn (get li_at cookie from browser DevTools > Application > Cookies)
# LINKEDIN_COOKIE=your_li_at_cookie_value

# Optional enrichment / discovery APIs (leave blank for free path)
# HUNTER_API_KEY=
# APOLLO_API_KEY=
# FIRECRAWL_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_PLACES_API_KEY=

# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Proxy support (optional, pick one)
# PANOPTES_PROXY=http://user:pass@host:port
# PANOPTES_PROXY_FILE=proxies.txt
# PANOPTES_FREE_PROXY=true

# Scrape delay range in seconds
# PANOPTES_DELAY_MIN=1.0
# PANOPTES_DELAY_MAX=2.5

# Optional API / Next.js integration
# PANOPTES_API_KEY=your-secret
# PANOPTES_CORS_ORIGINS=http://localhost:3000,*

# Connectors — Claude MCP / Obsidian / ops tools
# OBSIDIAN_VAULT_PATH=C:\Users\you\Documents\MyVault
# SLACK_WEBHOOK_URL=
# DISCORD_WEBHOOK_URL=
# ZAPIER_WEBHOOK_URL=
# MAKE_WEBHOOK_URL=
# HUBSPOT_WEBHOOK_URL=
# PANOPTES_GENERIC_WEBHOOK_URL=
# NOTION_API_KEY=
# NOTION_DATABASE_ID=
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=